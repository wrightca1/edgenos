# python
__pycache__/
*.pyc

# editor
*.swp
.DS_Store
/output/

# in-tree build artifacts (Makefile builds objects in CWD)
*.o
platform/*/edged

# --- provenance: never commit third-party binaries or SDK-derived data ---
# Compiled tools (built in-tree; do not track ELF objects)
asic/fm6000/fm6000_i2c_bringup
asic/fm6000/fm6000_crm
asic/fm6000/fm6000_wr128
# Intel/Arista firmware, microcode and register-trace transcriptions.
# These are third-party works. They may be used locally for interoperability
# work but MUST NOT be committed or distributed. See docs/PROVENANCE.md.
*_spico_code.bin
ucode_*.raw
fwd*.txt
# (the MRL *loader* header is ours and IS tracked; only the data file is excluded)
mrl-table.txt

# build artifacts (were bloating history ~90MB; never commit these)
build/*/m1/*.cpio.gz
build/*/m1/*bzImage*
build/*/m1/payload/fm6000_*
build/*/m1/payload/fm6000load
build/*/m1/payload/fm6000reg
!build/*/m1/payload/*.sh
!build/*/m1/payload/*.c
# makefile builds standalone tools next to their sources
asic/fm6000/fm6000_bringup
asic/fm6000/fm6000_l2_probe
asic/fm6000/fm6000_sched
asic/fm6000/fm6000_crm
asic/fm6000/fm6000_mrl
asic/fm6000/fpdma_probe
asic/fm6000/fm6000_i2c_bringup
build/*/m1/payload/fpdma_probe
# 7050sx2 build artifacts (kernel + initrd) -- regenerable, never commit
build/*/m0/linux-i386
build/*/m0/initrd-i386
