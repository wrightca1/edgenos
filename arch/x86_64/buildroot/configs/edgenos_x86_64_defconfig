# EdgeNOS x86_64 base system — Buildroot defconfig.
#
# Builds the "proven base" for every x86_64 EdgeNOS target: a 6.1 LTS kernel, a
# systemd + glibc userland, and the boot pieces (initramfs, GRUB for BIOS and UEFI).
# The rootfs squashfs this emits is captured by `edgenos pkg base` into
# base_<ver>_x86_64-<asic>.epk; imgbuild overlays the component packages on top.
#
# CPU baseline is generic x86-64 (no -march above the v1 baseline) so one image runs
# on both Intel and AMD hosts, and under any QEMU -cpu model.
#
# Build:  build/build-base-x86_64.sh   (wraps: make BR2_EXTERNAL=arch/x86_64/buildroot ...)

# ---- target --------------------------------------------------------------------
BR2_x86_64=y
BR2_x86_x86_64=y
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_KERNEL_HEADERS_6_1=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_SHARED_STATIC_LIBS=y
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y

# ---- system --------------------------------------------------------------------
BR2_TARGET_GENERIC_HOSTNAME="edgenos"
BR2_TARGET_GENERIC_ISSUE="EdgeNOS"
BR2_INIT_SYSTEMD=y
BR2_TARGET_GENERIC_ROOT_PASSWD="edgenos"
BR2_TARGET_GENERIC_GETTY_PORT="ttyS0"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_115200=y
BR2_SYSTEM_DHCP=""
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_EDGENOS_PATH)/board/x86_64/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_EDGENOS_PATH)/board/x86_64/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_EDGENOS_PATH)/board/x86_64/post-image.sh"
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_EDGENOS_PATH)/board/x86_64/busybox.fragment"

# ---- kernel: 6.1 LTS, Buildroot's qemu x86_64 baseline + EdgeNOS fragment --------
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.1.183"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="board/qemu/x86_64/linux.config"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_EDGENOS_PATH)/board/x86_64/linux.fragment"
BR2_LINUX_KERNEL_NEEDS_HOST_LIBELF=y

# ---- userland ------------------------------------------------------------------
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_BASH=y
BR2_PACKAGE_GZIP=y
BR2_PACKAGE_TAR=y
BR2_PACKAGE_XZ=y
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
BR2_PACKAGE_UTIL_LINUX_LOSETUP=y
BR2_PACKAGE_UTIL_LINUX_MOUNT_UMOUNT=y
BR2_PACKAGE_UTIL_LINUX_FSCK=y
BR2_PACKAGE_UTIL_LINUX_LSBLK=y
BR2_PACKAGE_UTIL_LINUX_FINDFS=y
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_E2FSPROGS_RESIZE2FS=y
BR2_PACKAGE_DOSFSTOOLS=y
BR2_PACKAGE_DOSFSTOOLS_FSCK_FAT=y
BR2_PACKAGE_DOSFSTOOLS_MKFS_FAT=y
BR2_PACKAGE_KMOD=y
BR2_PACKAGE_KMOD_TOOLS=y
BR2_PACKAGE_PCIUTILS=y
BR2_PACKAGE_DMIDECODE=y
BR2_PACKAGE_IPROUTE2=y
BR2_PACKAGE_ETHTOOL=y
BR2_PACKAGE_BRIDGE_UTILS=y
BR2_PACKAGE_NFTABLES=y
BR2_PACKAGE_IPTABLES=y
BR2_PACKAGE_TCPDUMP=y
BR2_PACKAGE_IPERF3=y
BR2_PACKAGE_SOCAT=y
BR2_PACKAGE_LLDPD=y
BR2_PACKAGE_OPENSSH=y
BR2_PACKAGE_OPENSSH_CLIENT=y
BR2_PACKAGE_OPENSSH_SERVER=y
BR2_PACKAGE_OPENSSH_KEY_UTILS=y
BR2_PACKAGE_WGET=y
BR2_PACKAGE_CA_CERTIFICATES=y
BR2_PACKAGE_NANO=y
BR2_PACKAGE_LIBREADLINE=y
BR2_PACKAGE_NCURSES=y
BR2_PACKAGE_PYTHON3=y
BR2_PACKAGE_PYTHON3_PY_PYC=y
BR2_PACKAGE_PYTHON3_READLINE=y
BR2_PACKAGE_PYTHON3_SSL=y
BR2_PACKAGE_PYTHON3_ZLIB=y
# control plane: FRR (EVPN, BGP unnumbered, EVPN-MH, BFD) — the virtual platform's default
BR2_PACKAGE_FRR=y
BR2_PACKAGE_FRR_BFD=y
BR2_PACKAGE_FRR_MULTIPATH_MAX=128
BR2_PACKAGE_FRR_PROTOBUF=y
BR2_PACKAGE_SYSTEMD_NETWORKD=y
BR2_PACKAGE_SYSTEMD_RESOLVED=y
BR2_PACKAGE_SYSTEMD_TIMESYNCD=y
BR2_PACKAGE_SYSTEMD_LOGIND=y

# ---- host tools used by the image/disk build ------------------------------------
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_MTOOLS=y
BR2_PACKAGE_HOST_E2FSPROGS=y
BR2_PACKAGE_HOST_SQUASHFS=y

# ---- bootloader: GRUB2 for legacy BIOS and x86_64 UEFI ---------------------------
BR2_TARGET_GRUB2=y
BR2_TARGET_GRUB2_I386_PC=y
BR2_TARGET_GRUB2_X86_64_EFI=y
# (the final grub.img / bootx64.efi are regenerated by post-image.sh with the early config in a
#  memdisk; these Buildroot builtin settings only shape the intermediate images)
BR2_TARGET_GRUB2_BUILTIN_MODULES_PC="boot linux ext2 fat squash4 part_msdos part_gpt normal biosdisk search search_label search_fs_uuid configfile echo test serial terminal sleep memdisk tar"
BR2_TARGET_GRUB2_BUILTIN_MODULES_EFI="boot linux ext2 fat squash4 part_msdos part_gpt normal efi_gop efi_uga search search_label search_fs_uuid configfile echo test serial terminal sleep memdisk tar"

# ---- filesystem images ----------------------------------------------------------
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_XZ=y
BR2_TARGET_ROOTFS_TAR=y
# BR2_TARGET_ROOTFS_EXT2 is not set
