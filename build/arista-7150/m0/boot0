#!/bin/sh
# EdgeNOS M0 stage-0 boot -- copy our kernel+initramfs from the SWI and kexec it.
# Aboot exports $swipath (path to this SWI) and provides busybox unzip + kexec.
kernel=linux-i386
arch=i386
: "${swipath:=$0}"
if [ -d "${swipath}" ]; then
   cp "${swipath}/${kernel}" "${swipath}/initrd-${arch}" /tmp/
else
   unzip -oq "${swipath}" "${kernel}" "initrd-${arch}" -d /tmp
fi
# REBOOT (root-caused): the hang is the SMP state around the reset, not the reset
# method (reboot=p AND reboot=t both froze). Post-kexec the AP cores wedge:
# reboot -f loops forever in stop_other_cpus(), and CF9/triple-fault won't reset
# while other cores are alive. Fix: nosmp (only BSP online) + reboot=p,force
# (skip machine_shutdown teardown, straight to CF9 = EOS's method). Use reboot -f.
# (swiotlb=force was tried and did NOT fix tg3 RX — dropped; it's an RGMII PHY
# issue, fixed by building the Broadcom PHY driver in-kernel.)
echo "console=ttyS0,9600 earlyprintk=serial,ttyS0,9600 rdinit=/init panic=10 nosmp reboot=p,force" > /tmp/append
kexec --load --initrd="/tmp/initrd-${arch}" --append="$(cat /tmp/append)" "/tmp/${kernel}"
kexec --exec
