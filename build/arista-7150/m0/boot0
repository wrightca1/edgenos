#!/bin/sh
# EdgeNOS M0 stage-0 boot -- copy our kernel+initramfs from the SWI and kexec it.
# Aboot exports $swipath (path to this SWI) and provides busybox unzip + kexec.
kernel=linux-i386
arch=i386
: "${swipath:=$0}"
if [ -d "${swipath}" ]; then
   cp "${swipath}/${kernel}" "${swipath}/initrd-${arch}" /tmp/
else
   unzip -oq "${swipath}" "${kernel}" "initrd-${arch}" -d /tmp
fi
# REBOOT: reboot=p (CF9 PCI reset, what EOS uses) HANGS this box from our kernel —
# the box freezes at "sysrq: Resetting" (machine reset never fires). reboot=t
# (triple fault) forces a CPU-level reset the chipset always honors. panic=10
# auto-reboots on panic. (Live-diagnosed M1 v2, phase15/16.)
echo "console=ttyS0,9600 earlyprintk=serial,ttyS0,9600 rdinit=/init panic=10 reboot=t" > /tmp/append
kexec --load --initrd="/tmp/initrd-${arch}" --append="$(cat /tmp/append)" "/tmp/${kernel}"
kexec --exec
