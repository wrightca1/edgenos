#!/bin/busybox sh
# EdgeNOS M1 init — platform bring-up (shell/sysfs only; no python yet).
# Loads the mgmt/i2c/hwmon/SCD drivers, declares the SCD board blocks, enables
# SFP lasers, and dumps platform status. EOS is untouched on flash.
/bin/busybox --install -s /bin
mount -t proc     none /proc 2>/dev/null
mount -t sysfs    none /sys  2>/dev/null
mount -t devtmpfs none /dev  2>/dev/null

# Reboot: cmdline has `nosmp reboot=p,force`, so `reboot -f` now works (no APs to
# hang stopping; ,force skips the teardown -> straight to CF9). sysrq stays on as
# a backup. (Root-caused M1 v3: the hang was the SMP-state, not the reset method.)
echo 1 > /proc/sys/kernel/sysrq 2>/dev/null

echo; echo "=================================================================="
echo "  EdgeNOS M1 — platform bring-up on the Arista DCS-7150S-52 (FM6000)"
echo "  $(uname -a)"
echo "=================================================================="

echo "--- loading drivers (order: i2c/net, then hwmon, then SCD) ---"
for m in i2c-dev broadcom tg3 at24 pmbus_core ucd9000 max31790 lm90 lm75 scd scd-hwmon raven-fan-driver; do
    if modprobe "$m" 2>/dev/null; then echo "  loaded  $m"; else echo "  skip    $m (absent/dep)"; fi
done

echo "--- declaring SCD board blocks + enabling SFP TX ---"
[ -x /usr/lib/edgenos/platform/scd-setup.sh ] && sh /usr/lib/edgenos/platform/scd-setup.sh
[ -x /usr/lib/edgenos/platform/sfp-enable.sh ] && sh /usr/lib/edgenos/platform/sfp-enable.sh

echo "--- platform status ---"
echo "  PCI (SCD 3475 / mgmt 14e4 / FM6000 8086):"
for d in /sys/bus/pci/devices/*/; do
    v=$(cat "$d/vendor" 2>/dev/null); dv=$(cat "$d/device" 2>/dev/null)
    echo "    $(basename "$d")  $v:$dv"
done | grep -iE '0x3475|0x14e4|0x8086|0x1002|0x1022'
echo "  LEDs:";        ls /sys/class/leds 2>/dev/null | sed 's/^/    /'
echo "  i2c adapters:"; ls /sys/class/i2c-dev 2>/dev/null | sed 's/^/    /'
echo "  hwmon:";        for h in /sys/class/hwmon/hwmon*; do [ -e "$h/name" ] && echo "    $(basename "$h") $(cat "$h/name")"; done
echo "  xcvr cages:";  ls -d /sys/bus/platform/devices/scd-xcvr*/sfp* 2>/dev/null | sed 's/^/    /'

# --- mgmt NIC diagnostic (tg3 RX / RGMII-PHY fix) ---
echo "--- mgmt NIC (eth0) + network access ---"
if [ -d /sys/class/net/eth0 ]; then
    ip link set eth0 up 2>/dev/null
    ip addr add "${MGMT_IP:-10.1.1.77}/24" dev eth0 2>/dev/null
    echo "    eth0 up, ${MGMT_IP:-10.1.1.77}/24  PHY: $(readlink -f /sys/class/net/eth0/phydev/driver 2>/dev/null | sed 's#.*/##')"
    sleep 2
    # real SSH (dropbear, root pw 'arista') + telnet + scripted nc-shell (2323)
    if [ -x /usr/sbin/dropbear ]; then
        [ -f /etc/dropbear/dropbear_ed25519_host_key ] || \
            dropbearkey -t ed25519 -f /etc/dropbear/dropbear_ed25519_host_key >/dev/null 2>&1
        [ -f /etc/dropbear/dropbear_rsa_host_key ] || \
            dropbearkey -t rsa -f /etc/dropbear/dropbear_rsa_host_key >/dev/null 2>&1
        /usr/sbin/dropbear -p 22 -R >/dev/null 2>&1 && echo "    dropbear SSH up (root, pw arista)"
    fi
    telnetd -l /bin/sh -p 23 2>/dev/null && echo "    telnetd up (:23)"
    [ -x /usr/bin/ncsh.sh ] && { setsid /usr/bin/ncsh.sh >/dev/null 2>&1 & echo "    nc-shell up (:2323)"; }
else
    echo "    eth0 absent (tg3 bind failed)"
fi

# --- M2: auto FM6000 bring-up in the CORRECT order (clock -> reset-release) ---
# Runs while the FM6000 is still held in reset (0x4000=0x106) from power-on, so it
# comes out of reset WITH the Si5338 refclk present. Full log in /var/log/fm6000.
if [ -x /usr/lib/edgenos/platform/fm6000-up.sh ]; then
    echo "--- M2 FM6000 auto bring-up (full log: /var/log/fm6000) ---"
    mkdir -p /var/log
    sh /usr/lib/edgenos/platform/fm6000-up.sh > /var/log/fm6000 2>&1
    grep -iE 'ENUMERATED|still absent|PLL_LOL|Si5338 found|smbus_master @|clock RC' /var/log/fm6000 | sed 's/^/    /'
fi

# --- reboot staging diagnostic (answers the netboot question) ---
echo "--- reboot: kexec pre-staged by Aboot? ---"
echo "    /sys/kernel/kexec_loaded = $(cat /sys/kernel/kexec_loaded 2>/dev/null) (1 = Aboot staged one; 0 = we must stage)"

echo
echo "=================================================================="
echo "  COMPREHENSIVE TEST MENU (one boot):"
echo "  1) mgmt net : ip addr add 10.1.1.78/24 dev eth0; ping 10.1.1.30"
echo "                cat /sys/class/net/eth0/statistics/rx_packets rx_errors"
echo "  2) SCD LED  : echo 1 > /sys/class/leds/status1/brightness   (declare via scd-setup.sh)"
echo "  3) M2 fm6000: sh /usr/lib/edgenos/platform/fm6000-up.sh"
echo "  4) reboot   : sh /usr/lib/edgenos/platform/to-eos.sh   (kexec back to EOS)"
echo "     hw reset : resettool kbd | cf9 | cf9cold   (try each; may hang)"
echo "  Do the network + M2 + LED tests BEFORE reboot (reboot ends the session)."
echo "=================================================================="
exec setsid cttyhack /bin/busybox sh
