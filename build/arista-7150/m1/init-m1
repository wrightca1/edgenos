#!/bin/busybox sh
# EdgeNOS M1 init — platform bring-up (shell/sysfs only; no python yet).
# Loads the mgmt/i2c/hwmon/SCD drivers, declares the SCD board blocks, enables
# SFP lasers, and dumps platform status. EOS is untouched on flash.
/bin/busybox --install -s /bin
mount -t proc     none /proc 2>/dev/null
mount -t sysfs    none /sys  2>/dev/null
mount -t devtmpfs none /dev  2>/dev/null

# Reboot: cmdline has `nosmp reboot=p,force`, so `reboot -f` now works (no APs to
# hang stopping; ,force skips the teardown -> straight to CF9). sysrq stays on as
# a backup. (Root-caused M1 v3: the hang was the SMP-state, not the reset method.)
echo 1 > /proc/sys/kernel/sysrq 2>/dev/null

echo; echo "=================================================================="
echo "  EdgeNOS M1 — platform bring-up on the Arista DCS-7150S-52 (FM6000)"
echo "  $(uname -a)"
echo "=================================================================="

echo "--- loading drivers (order: i2c/net, then hwmon, then SCD) ---"
for m in i2c-dev broadcom tg3 at24 pmbus_core ucd9000 max31790 lm90 lm75 scd scd-hwmon raven-fan-driver; do
    if modprobe "$m" 2>/dev/null; then echo "  loaded  $m"; else echo "  skip    $m (absent/dep)"; fi
done

echo "--- declaring SCD board blocks + enabling SFP TX ---"
[ -x /usr/lib/edgenos/platform/scd-setup.sh ] && sh /usr/lib/edgenos/platform/scd-setup.sh
[ -x /usr/lib/edgenos/platform/sfp-enable.sh ] && sh /usr/lib/edgenos/platform/sfp-enable.sh

# WARM-INHERIT safety: on a kexec-from-EOS boot, EOS left the SCD hardware watchdog
# ARMED. If M1 doesn't pet/disarm it, it fires an NMI + reboots the box ~30s in (seen
# on the warm boot: "NMI received for unknown reason" -> reboot). Disarm it early.
# Harmless on a cold Aboot boot (WD not yet armed at power-on).
[ -f /warm-inherit ] && [ -x /usr/bin/scdreg ] && { scdreg 0x0120 0x0 >/dev/null 2>&1; echo "    SCD watchdog disarmed (warm-inherit; was armed by EOS)"; }

# COLD-INIT-TEST safety (marker /cold-init-test) — makes a MCAST banked-ECC cold-init
# experiment REMOTELY RECOVERABLE. Runs BEFORE any FM6000 bring-up / MCAST touch:
#   1. Self-revert boot-config -> EOS on flash (we can write flash now: USB block drv),
#      so ANY reboot — a watchdog NMI on a chip wedge, or a manual one — returns to EOS
#      and never loops this test image.
#   2. Arm the SCD hardware watchdog + a background re-armer. A hard chip wedge that
#      stalls the CPU stops the petting -> WD fires -> reboot -> EOS (~30s). A wedge
#      that leaves the CPU alive keeps petting -> recover with SCD 0xDEAD by hand.
# This closes the cold-path gap (cold bring-up otherwise arms NO watchdog).
if [ -f /cold-init-test ]; then
    echo "--- COLD-INIT-TEST: arming remote-recovery safety BEFORE FM6000 bring-up ---"
    if [ -b /dev/sda1 ] && { mount -t vfat /dev/sda1 /mnt/flash 2>/dev/null || mkdir -p /mnt/flash && mount /dev/sda1 /mnt/flash 2>/dev/null; }; then
        # STICKY MODE, for automated cold-boot bisection of the replay set.
        # /mnt/flash/edgenos-sticky holds a BOOT BUDGET. While it is > 0 we
        # decrement it and keep booting this image, so a harness can cold-boot
        # back-to-back instead of paying an EOS round-trip every iteration.
        # When it reaches 0 -- including when a wedge-reboot burns through it --
        # we revert to EOS exactly as before. The budget is what keeps this
        # safe: a boot loop terminates itself in EOS instead of spinning.
        STICKY=0
        [ -f /mnt/flash/edgenos-sticky ] && STICKY=$(cat /mnt/flash/edgenos-sticky 2>/dev/null)
        case "$STICKY" in ''|*[!0-9]*) STICKY=0;; esac
        if [ "$STICKY" -gt 0 ]; then
            echo $((STICKY - 1)) > /mnt/flash/edgenos-sticky; sync
            echo "    STICKY: $((STICKY - 1)) boot(s) left before auto-revert to EOS"
        else
            rm -f /mnt/flash/edgenos-sticky 2>/dev/null
            printf 'SWI=flash:/EOS-4.16.8M.swi\n' > /mnt/flash/boot-config; sync
            echo "    boot-config self-reverted -> $(cat /mnt/flash/boot-config) (any reboot = EOS)"
        fi
    else
        echo "    *** could not mount /dev/sda1 to self-revert boot-config — UNSAFE, dropping to shell ***"
        exec setsid cttyhack /bin/busybox sh
    fi
    if [ -x /usr/bin/scdreg ]; then
        scdreg 0x0120 0xC0000BB8 >/dev/null 2>&1
        ( while :; do scdreg 0x0120 0xC0000BB8 >/dev/null 2>&1; sleep 8; done ) &
        echo "    SCD watchdog ARMED + bg re-armer (pid $!) wd=$(scdreg 0x0120 2>/dev/null | grep -o '0x[0-9a-f]*$')"
    fi
fi

echo "--- platform status ---"
echo "  PCI (SCD 3475 / mgmt 14e4 / FM6000 8086):"
for d in /sys/bus/pci/devices/*/; do
    v=$(cat "$d/vendor" 2>/dev/null); dv=$(cat "$d/device" 2>/dev/null)
    echo "    $(basename "$d")  $v:$dv"
done | grep -iE '0x3475|0x14e4|0x8086|0x1002|0x1022'
echo "  LEDs:";        ls /sys/class/leds 2>/dev/null | sed 's/^/    /'
echo "  i2c adapters:"; ls /sys/class/i2c-dev 2>/dev/null | sed 's/^/    /'
echo "  hwmon:";        for h in /sys/class/hwmon/hwmon*; do [ -e "$h/name" ] && echo "    $(basename "$h") $(cat "$h/name")"; done
echo "  xcvr cages:";  ls -d /sys/bus/platform/devices/scd-xcvr*/sfp* 2>/dev/null | sed 's/^/    /'

# --- mgmt NIC diagnostic (tg3 RX / RGMII-PHY fix) ---
echo "--- mgmt NIC (eth0) + network access ---"
if [ -d /sys/class/net/eth0 ]; then
    ip link set eth0 up 2>/dev/null

    # --- management addressing: STATIC, with a documented default ----------
    # The management port comes up on a fixed address so the switch is always
    # reachable at a known place on a bench, with no dependency on a DHCP server
    # being present. Nothing about anyone's network is baked in beyond a
    # conventional private default.
    #
    #   default:  192.168.1.1/24, no gateway
    #   change it: put the values in /mnt/flash/mgmt.conf, which is read here and
    #              is NOT part of this repository:
    #
    #                 MGMT_IP=198.51.100.10/24
    #                 MGMT_GW=198.51.100.1          # optional default route
    #                 MGMT_ROUTE=203.0.113.0/24   # optional, see below
    #
    #   or at runtime:  ip addr add <a.b.c.d/len> dev eth0
    #
    # (An earlier build tried DHCP here. It failed for a reason worth recording:
    # tg3 brings this link up at t=27s, well after init reaches this point, so
    # udhcpc broadcast into a dead link and left eth0 with no address at all.
    # A static default has no such race.)
    [ -f /mnt/flash/mgmt.conf ] && . /mnt/flash/mgmt.conf 2>/dev/null
    MGMT_IP="${MGMT_IP:-192.168.1.1/24}"

    ip addr add "$MGMT_IP" dev eth0 2>/dev/null
    [ -n "$MGMT_GW" ] && ip route add default via "$MGMT_GW" 2>/dev/null
    echo "    eth0 up, $MGMT_IP${MGMT_GW:+ via $MGMT_GW}  (change: /mnt/flash/mgmt.conf)"

    # ⚠ Once ospfd is up it installs routes via the front panel, and one of them
    # can be more specific than the default -- replies then leave by the wrong
    # interface and mgmt dies the moment edgenos-up.sh runs. A site whose admin
    # network is reachable only via eth0 pins it with MGMT_ROUTE in mgmt.conf.
    if [ -n "$MGMT_ROUTE" ] && [ -n "$MGMT_GW" ]; then
        ip route add "$MGMT_ROUTE" via "$MGMT_GW" dev eth0 metric 5 2>/dev/null
        echo "    pinned $MGMT_ROUTE via $MGMT_GW dev eth0 (metric 5)"
    fi
    echo "    PHY: $(readlink -f /sys/class/net/eth0/phydev/driver 2>/dev/null | sed 's#.*/##')"
    sleep 2
    # real SSH (dropbear, root pw 'arista') + telnet + scripted nc-shell (2323)
    if [ -x /usr/sbin/dropbear ]; then
        [ -f /etc/dropbear/dropbear_ed25519_host_key ] || \
            dropbearkey -t ed25519 -f /etc/dropbear/dropbear_ed25519_host_key >/dev/null 2>&1
        [ -f /etc/dropbear/dropbear_rsa_host_key ] || \
            dropbearkey -t rsa -f /etc/dropbear/dropbear_rsa_host_key >/dev/null 2>&1
        # DEFAULT CREDENTIAL, documented on purpose: root / arista, matching the
        # platform's factory default. It is not a secret and is not site-specific;
        # an operator changes it with passwd, or drops an authorized_keys into
        # /mnt/flash/authorized_keys. Shipping a documented default beats shipping
        # somebody's lab password.
        /usr/sbin/dropbear -p 22 -R >/dev/null 2>&1 && \
            echo "    dropbear SSH up (default login: root / arista -- change it)"
    fi
    telnetd -l /bin/sh -p 23 2>/dev/null && echo "    telnetd up (:23)"
    [ -x /usr/bin/ncsh.sh ] && { setsid /usr/bin/ncsh.sh >/dev/null 2>&1 & echo "    nc-shell up (:2323)"; }
else
    echo "    eth0 absent (tg3 bind failed)"
fi

# --- WARM-INHERIT (kexec from a running EOS): the FM6000 was fully configured by
# EOS and is NOT in reset (reset bits latch only at power-on; a kexec is a warm CPU
# reboot -> the chip keeps EOS's state, incl. initialized MCAST/bank ECC + tables).
# So do NOT run fm6000-up.sh (it assumes a fresh in-reset chip and would try to
# re-clock/re-reset). Just re-scan PCI, enable BAR0 MMIO, and inherit. Boot with
# kernel cmdline containing `fm6000_warm`. ------------------------------------------
if grep -q fm6000_warm /proc/cmdline 2>/dev/null || [ -f /warm-inherit ]; then
    # (the M1 kernel has CONFIG_CMDLINE_FORCE so kexec --command-line is ignored;
    #  the /warm-inherit marker file in the warm initramfs is what selects this path)
    echo "--- WARM-INHERIT: FM6000 kept from EOS (no reset/bring-up) ---"
    echo 1 > /sys/bus/pci/rescan 2>/dev/null; sleep 1
    Bw=0000:02:00.0
    if [ -e /sys/bus/pci/devices/$Bw/vendor ]; then
        if [ -x /usr/bin/pcicfg ]; then
            Vw=$(pcicfg $Bw 0x04 2>/dev/null | grep -o '0x[0-9a-f]*$')
            pcicfg $Bw 0x04 $(printf '0x%x' $(( ${Vw:-0} | 0x6 ))) >/dev/null 2>&1   # Mem+BusMaster
        fi
        echo "    FM6000 inherited: $(cat /sys/bus/pci/devices/$Bw/vendor):$(cat /sys/bus/pci/devices/$Bw/device) Command=$(pcicfg $Bw 0x04 2>/dev/null|grep -o '0x[0-9a-f]*$')"
        if [ -x /usr/bin/fm6000reg ]; then
            echo "    inherited state: CAM0=0x$(fm6000reg $Bw 0x0e000 2>/dev/null|grep -o '[0-9a-f]*$') MCAST_DEST[4112]=0x$(fm6000reg $Bw 0x244040 2>/dev/null|grep -o '[0-9a-f]*$') (want 00003fff = EOS config alive)"
            # --- phase70: capture the SRBM (Shared Repairable Bank Memory) repair table ---
            # The SPI boot loaded fusebox cell-repairs into SRBM_REPAIR[0..7] (0x1D700+i).
            # Each: BadAddr[15:0] MemBankID[23:16] MemChain[26:24] RepairValid[27].
            # SRBM_STATUS 0x1D70D: FirstNewRepair[3:0] FirstEmptyRepair[7:4]=#loaded.
            echo "    ===== SRBM-CAPTURE (phase70: warm/SPI-booted repair table) ====="
            echo "    [SRBM] GENERAL_CONFIG 0x1D70C = 0x$(fm6000reg $Bw 0x1D70C 2>/dev/null|grep -o '[0-9a-f]*$')"
            echo "    [SRBM] STATUS        0x1D70D = 0x$(fm6000reg $Bw 0x1D70D 2>/dev/null|grep -o '[0-9a-f]*$')  (FirstEmptyRepair[7:4]=#loaded)"
            echo "    [SRBM] LAST_NR_DEF   0x1D713 = 0x$(fm6000reg $Bw 0x1D713 2>/dev/null|grep -o '[0-9a-f]*$')"
            for off in 0 1 2 3 4 5 6 7; do
                reg=$(printf 0x%X $((0x1D700 + off)))
                echo "    [SRBM] REPAIR[$off]  $reg = 0x$(fm6000reg $Bw $reg 2>/dev/null|grep -o '[0-9a-f]*$')"
            done
            echo "    [SRBM] BM_GENERAL_CONFIG 0x1D084 = 0x$(fm6000reg $Bw 0x1D084 2>/dev/null|grep -o '[0-9a-f]*$')"
            echo "    ===== end SRBM-CAPTURE ====="
        fi
    else
        echo "    *** FM6000 02:00.0 NOT present after warm boot — inherit FAILED ***"
    fi
# --- M2: auto FM6000 bring-up in the CORRECT order (clock -> reset-release) ---
# Runs while the FM6000 is still held in reset (0x4000=0x106) from power-on, so it
# comes out of reset WITH the Si5338 refclk present. Full log in /var/log/fm6000.
elif [ -x /usr/lib/edgenos/platform/fm6000-up.sh ]; then
    echo "--- M2 FM6000 auto bring-up (full log: /var/log/fm6000) ---"
    mkdir -p /var/log
    # FM6000_BIST=1: run the cold-BIST memory init in the pre-enum scan window (over
    # the i2c slave) so forwarding-table RAM is parity-valid → CPU-punt table writes
    # don't wedge the chip. This is the ONLY window it's reachable (fresh reset).
    # Watch the serial console — if BIST hangs the CPU there's no watchdog yet.
    # phase73: FM6000_RUNBIST=1 runs the BM BIST march (not SPIBOOT_TRUST) so we can test whether
    # the march initializes the FUNCTIONAL-path banks — the corrected cold-init model (BIST, not CRM).
    # phase86 COLD86 (option 2): clean SPIBOOT_TRUST enum (RUNBIST=0), then the probe block RELEASES the
    # switch core (SOFT_RESET=0) FIRST and programs config (full scheduler incl ESCHED/DRR) over MMIO AFTER
    # release — the untested correct ordering (cold83 wrote ESCHED before release -> off-bus).
    # phase90 PROBE: FM6000_NOFILL=1 loads the microcode (minus MOD) then leaves the chip ALIVE at the M1
    # shell (no CRM fill) for interactive probing over SSH. RUNBIST=0 (SPIBOOT_TRUST enum).
    FM6000_NOFILL="${FM6000_NOFILL:-1}" FM6000_RUNBIST="${FM6000_RUNBIST:-0}" FM6000_BIST="${FM6000_BIST:-1}" sh /usr/lib/edgenos/platform/fm6000-up.sh > /var/log/fm6000 2>&1
    grep -iE 'ENUMERATED|still absent|PLL_LOL|Si5338 found|smbus_master @|clock RC|BIST|i2c-bringup' /var/log/fm6000 | sed 's/^/    /'
fi



# --- thermal control (SAFETY) -----------------------------------------------
# Fans default to PWM 255 in hardware, which is safe but very loud, and nothing
# watches temperature -- so a failed fan would go unnoticed. Start the controller
# before anything else so the box is never running unattended without it.
if [ -x /usr/lib/edgenos/platform/thermal-control.sh ]; then
    echo "--- thermal control (log: /var/log/thermal) ---"
    setsid /usr/lib/edgenos/platform/thermal-control.sh -i 5 \
        </dev/null >/var/log/thermal 2>&1 &
    sleep 2
    sed -n '1,3p' /var/log/thermal | sed 's/^/    /'
else
    echo "--- thermal control MISSING -- fans stay at hardware default (full speed) ---"
fi

# --- dataplane auto bring-up ------------------------------------------------
# Bring the FM6000 all the way to a forwarding switch at boot, so the box comes
# up as a router with no manual steps. Gated on the replay set being present:
# it is operator-supplied (not distributable), so an image without it simply
# skips this and drops to the shell as before. See docs/PROVENANCE.md.
#
# PACE matters, and the units are per-16384-ops: PACE=2000 adds only ~46 ms in
# total and is effectively unpaced. The default adds ~34 s. Copper (Et2) seems
# to need it; evidence is still thin. See docs/ET2-COPPER-LINK.md.
FWD=""
for f in /mnt/flash/fwd4.txt /mnt/flash/fwd5.txt; do [ -f "$f" ] && { FWD="$f"; break; }; done
if [ -n "$FWD" ] && [ -x /usr/bin/fm6000_coldreplay ] && \
   [ -x /usr/lib/edgenos/platform/fm6000-fullseq.sh ]; then
    echo "--- FM6000 dataplane auto bring-up (replay $FWD, log /var/log/fm6000-fullseq) ---"
    # PACE is settable from flash so an experiment can change arms without a
    # rebuild: echo 2000 > /mnt/flash/pace.conf makes the replay effectively
    # unpaced, and removing the file restores the default. The 50% Et2 link rate
    # measured 2026-08-16 was WITH the default pacing already applied, and the
    # recorded evidence for pacing is thin ("unpaced 2/5, genuinely paced 1/1"),
    # so this is the knob that experiment needs.
    [ -r /mnt/flash/pace.conf ] && PACE=$(tr -dc 0-9 < /mnt/flash/pace.conf)
    [ -n "${PACE:-}" ] || PACE=1500000
    echo "    PACE=$PACE"
    FWD="$FWD" PACE="$PACE" \
        sh /usr/lib/edgenos/platform/fm6000-fullseq.sh > /var/log/fm6000-fullseq 2>&1
    grep -E 'PORT_STATUS|t=40s|DONE' /var/log/fm6000-fullseq | tail -3 | sed 's/^/    /'
    for p in "Et1 0xe3800 0xe3826" "Et2 0xe4000 0xe4026"; do
        set -- $p
        st=$(fm6000reg 0000:02:00.0 $2 2>/dev/null | sed 's/.*= 0x//')
        rx=$(fm6000reg 0000:02:00.0 $3 2>/dev/null | sed 's/.*= 0x//')
        case "$rx" in 00000001) v="UP" ;; *) v="down" ;; esac
        echo "    $1: $v (PORT_STATUS=$st)"
    done
else
    echo "--- FM6000 dataplane auto bring-up SKIPPED (no replay set on flash) ---"
fi

# --- dataplane watchdog (checklist E0a) -------------------------------------
# The failure mode nothing else covers is "Linux healthy, dataplane dead": the
# kernel's nmi_watchdog=panic handles a CPU lockup, and there is no /dev/watchdog
# on this board, so an ASIC wedge with a live CPU used to sit there forever.
#
# It was written and hardware-validated on 2026-08-11 and then never started
# automatically, which made it useless exactly when it was needed -- 2026-08-15
# saw three consecutive mid-FULLSEQ resets with nothing watching. Start it here.
#
# Ping is deliberately NOT a signal (D5 makes it fail on a healthy box); it
# watches PIN_STRAP and the kernel route count. /mnt/flash/wdog.off disables it
# and the binary honours that itself -- create that file before any experiment
# that deliberately downs the dataplane.
# --- kernel self-recovery: set it HERE, not via the cmdline --------------------
# m0/boot0 kexecs with "panic=10 nosmp reboot=p,force" and dmesg confirms the
# kernel receives it -- but on alpha42 /proc/sys/kernel/panic still read 0, so a
# panic would HANG THE BOX FOREVER instead of resetting. Rather than chase why,
# set it directly: this is verifiable after boot and independent of the cmdline.
# (Note /proc/cmdline on this box reports Aboot's line, not ours -- use dmesg.)
#
# fm6000_wdog cannot cover this: it is userspace and dies with the kernel.
#   panic=10        reboot 10s after a panic (Aboot then self-reverts to EOS)
#   panic_on_oops=1 turn an oops into a panic, so a half-dead kernel reboots too
# ⚠ This kernel has NO lockup detectors -- softlockup_panic, hung_task_panic and
# nmi_watchdog are all absent from /proc/sys/kernel, so a silent CPU lockup is
# still unrecoverable; fixing that needs a kernel config change, not a sysctl.
echo 10 > /proc/sys/kernel/panic 2>/dev/null
echo 1  > /proc/sys/kernel/panic_on_oops 2>/dev/null
echo "--- kernel self-recovery: panic=$(cat /proc/sys/kernel/panic 2>/dev/null) panic_on_oops=$(cat /proc/sys/kernel/panic_on_oops 2>/dev/null) ---"

if [ -n "$FWD" ] && [ -x /usr/bin/fm6000_wdog ]; then
    if [ -f /mnt/flash/wdog.off ]; then
        echo "--- dataplane watchdog DISABLED (/mnt/flash/wdog.off present) ---"
    else
        setsid /usr/bin/fm6000_wdog >/dev/null 2>&1 </dev/null &
        echo "--- dataplane watchdog started (pid $!, log /mnt/flash/wdog.log) ---"
    fi
fi

# --- reboot staging diagnostic (answers the netboot question) ---
echo "--- reboot: kexec pre-staged by Aboot? ---"
echo "    /sys/kernel/kexec_loaded = $(cat /sys/kernel/kexec_loaded 2>/dev/null) (1 = Aboot staged one; 0 = we must stage)"

echo
echo "=================================================================="
echo "  COMPREHENSIVE TEST MENU (one boot):"
echo "  1) mgmt net : DHCP by default; for a fixed address put MGMT_IP=a.b.c.d/len in /mnt/flash/mgmt.conf"
echo "                cat /sys/class/net/eth0/statistics/rx_packets rx_errors"
echo "  2) SCD LED  : echo 1 > /sys/class/leds/status1/brightness   (declare via scd-setup.sh)"
echo "  3) M2 fm6000: sh /usr/lib/edgenos/platform/fm6000-up.sh"
echo "  4) reboot   : sh /usr/lib/edgenos/platform/to-eos.sh   (kexec back to EOS)"
echo "     hw reset : resettool kbd | cf9 | cf9cold   (try each; may hang)"
echo "  Do the network + M2 + LED tests BEFORE reboot (reboot ends the session)."
echo "=================================================================="
exec setsid cttyhack /bin/busybox sh
