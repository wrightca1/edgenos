# EdgeNOS M1/M2 kernel config fragment — merged onto the M0 minimal .config.
#
# The M0 kernel is intentionally tiny (serial console + initramfs only). M1 adds
# the platform userland's needs (mgmt NIC, i2c/hwmon, at24, squashfs rootfs);
# M2 adds VFIO for the FM6000 DMA path. One kernel serves both milestones.
#
# Apply:  ./build-m1-kernel.sh   (merges this via scripts/kconfig/merge_config.sh)
# Every symbol here was verified ABSENT/off in the M0 config; deps come via
# `select` + `make olddefconfig`.

# ---- squashfs rootfs (M1 ships a python3 rootfs inside the SWI, loop-mounted
#      from tmpfs = still RAM-only) ----
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_OVERLAY_FS=y
# CONFIG_BLK_DEV_LOOP already =y in M0; PCI_MSI already =y.

# ---- networking base (M0 had CONFIG_NET off entirely; M1 needs the IP stack
#      for the mgmt NIC + SSH/FRR, plus AF_PACKET for edged punt tooling) ----
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_ETHERNET=y

# ---- CPU-port punt netdev (edged-7150 TUN/TAP; used by M2 too) ----
CONFIG_TUN=m

# ---- SCD driver subsystem deps (found by building scd.ko against 6.12) ----
# Verified: with these two, scd.ko (core, 642KB) + raven-fan-driver.ko link clean.
CONFIG_UIO=m                    # scd.c: FPGA userspace/irq (uio_register/event_notify)
CONFIG_LEDS_CLASS_MULTICOLOR=m  # scd-led.c: led_classdev_multicolor / led_mc_calc_color
# RESOLVED (scd-hwmon.ko): scd-mdio.c's only use of mdio_mii_ioctl (CONFIG_MDIO,
# select-only, off here) was gearbox_ioctl for an external MDIO PHY — N/A on the
# 7150S (SFP+ SerDes internal to the FM6000). Patched the wrightca1/sonic fork to
# stub gearbox_ioctl -> -EOPNOTSUPP. All 3 modules (scd.ko/scd-hwmon.ko/raven-fan)
# now link clean against 6.12 and ship in edgenos-m1.swi.

# ---- i2c userspace + SFP/board EEPROM ----
CONFIG_I2C_CHARDEV=m
CONFIG_EEPROM_AT24=m

# ---- hwmon: PSU (UCD9012/PMBus), fan (MAX31790), temp (LM90/LM75) ----
CONFIG_PMBUS=m
CONFIG_SENSORS_PMBUS=m
CONFIG_SENSORS_UCD9000=m
CONFIG_SENSORS_MAX31790=m
CONFIG_SENSORS_LM90=m
CONFIG_SENSORS_LM75=m

# ---- management NIC (BCM5719 -> tg3); selects PHYLIB, pulls PTP optionally ----
CONFIG_NET_VENDOR_BROADCOM=y
CONFIG_TIGON3=m

# ---- M2: VFIO for the FM6000 DMA path. NOTE: this AMD RS780 box has no
#      dependable IOMMU, so NOIOMMU is the realistic mode here (confirm live).
#      If IOMMU turns out absent AND noiommu proves unworkable, fall back to a
#      small clean-room DMA kmod instead (see M0-BOOT-CHECKLIST Phase H0). ----
CONFIG_VFIO=m
CONFIG_VFIO_PCI=m
CONFIG_VFIO_NOIOMMU=y
