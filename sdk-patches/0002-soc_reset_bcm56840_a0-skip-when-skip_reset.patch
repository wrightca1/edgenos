+         * misc_init's MMU/EPIPE config ops complete. Pure CMIC routing/timeout config; it
+         * resets no block, so edged's live SCHAN keeps working. */
+        WRITE_CMIC_SBUS_TIMEOUTr(unit, 0x13500);
+        return SOC_E_NONE;
+    }
