+     * ring-map / re-asserting block resets kills the working SCHAN -> SchanTimeOut.
+     * So skip the entire chip reset and run soc_init on edged's live chip. */
+    if (soc_property_get(unit, spn_SOC_SKIP_RESET, 0)) {
+        return SOC_E_NONE;
+    }
