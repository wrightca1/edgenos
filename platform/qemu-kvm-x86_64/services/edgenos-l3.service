[Unit]
Description=EdgeNOS L3 config (addrs + static routes from /etc/edged)
After=edgenos-ports.service systemd-networkd.service
Wants=edgenos-ports.service
Before=zebra.service
ConditionPathExists=/etc/edged/addrs.conf

[Service]
Type=oneshot
Environment=EDGENOS_ETC=/etc/edged
ExecStart=/opt/edgenos/edgenos-l3-config.sh
RemainAfterExit=yes
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
