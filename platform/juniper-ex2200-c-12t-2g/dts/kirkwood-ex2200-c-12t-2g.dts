// SPDX-License-Identifier: GPL-2.0
/*
 * Juniper EX2200-C-12T-2G
 *
 * Marvell Kirkwood 88F6281 (Feroceon 88FR131, ARMv5TE, 800 MHz), 512 MB DRAM,
 * 8 MB SPI NOR, USB root device, Marvell Prestera DX (Cheetah-3) switch ASIC
 * on the internal bus.
 *
 * Every address and IRQ below was taken from a live Junos boot on the target,
 * not from a datasheet. See the junos-ex2200-static-analysis repo,
 * findings/16 (memory map) and findings/38 (ASIC port map).
 *
 * STATUS: first draft. Not yet compiled with dtc, not yet booted.
 */

/dts-v1/;

#include "kirkwood.dtsi"
#include "kirkwood-6281.dtsi"

/ {
	model = "Juniper EX2200-C-12T-2G";
	compatible = "juniper,ex2200-c-12t-2g", "marvell,kirkwood-88f6281",
		     "marvell,kirkwood";

	memory@0 {
		device_type = "memory";
		reg = <0x00000000 0x20000000>;	/* 512 MB, confirmed at boot */
	};

	chosen {
		/*
		 * bootargs MUST live here. U-Boot 1.1.6 on this board does not
		 * get a command line through to the kernel - ATAG_CMDLINE never
		 * arrives, even with CONFIG_ARM_ATAG_DTB_COMPAT - so 'setenv
		 * bootargs' at the prompt has no effect whatsoever.
		 *
		 * Proven the hard way: with this property present the kernel
		 * reported exactly this string as its command line; with it
		 * removed, the kernel booted with NO command line and produced
		 * no output at all, because earlyprintk was never enabled.
		 *
		 * Consequence: changing kernel arguments means rebuilding the
		 * DTB, not typing at the U-Boot prompt.
		 */
		bootargs = "console=ttyS0,9600 earlyprintk ignore_loglevel sysrq_always_enabled";
		stdout-path = &uart0;
	};

	/*
	 * Junos reserves 8 MB at physical 0x100000 and hands it to userland
	 * through /dev/mpfe region 0 for DMA buffers and descriptor rings
	 * (machdep.iomem_physaddr / iomem_size; findings/30, findings/34).
	 *
	 * We reserve the same SIZE but not the same ADDRESS. Junos can use
	 * 0x100000 because its kernel lives elsewhere; a Linux zImage
	 * decompresses to PHYS_OFFSET+TEXT_OFFSET (0x8000) and is ~12 MB, so
	 * 0x100000..0x900000 falls inside the kernel image and the reservation
	 * is refused:
	 *
	 *   OF: reserved mem: failed to reserve memory for node
	 *       'pfe-dma@100000': base 0x00100000, size 8 MiB
	 *
	 * A size-only reservation lets the kernel place it somewhere valid.
	 * The Prestera can DMA anywhere in the 512 MB, so the address is not
	 * architecturally significant - only the size is.
	 */
	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		pfe_dma: pfe-dma {
			size = <0x00800000>;		/* 8 MB, as Junos reserves */
			alignment = <0x00100000>;
			no-map;
		};
	};

	/*
	 * Front-panel button, on the SysPLD rather than a SoC GPIO.
	 * Junos reaches it via /dev/button. Left disabled until the SysPLD
	 * driver exists.
	 */
};

/* Console: 9600 8N1. The Kirkwood BootROM uses 115200, but only for kwboot. */
&uart0 {
	status = "okay";
};

/*
 * I2C: IDPROM at 0x72 (boot.ideeprom in the U-Boot environment), plus the
 * SysPLD and, on -12P- variants, the PoE controller. No PoE controller is
 * fitted on the 12T (/dev/poe is absent; poe0 attach fails at boot).
 */
&i2c0 {
	status = "okay";
	clock-frequency = <100000>;

	idprom: eeprom@72 {
		compatible = "atmel,24c02";
		reg = <0x72>;
		#address-cells = <1>;
		#size-cells = <1>;
		read-only;
		/*
		 * Layout: ad 01 00 40 ec 3e f7 5b bb 40
		 *   count 0x40 (64 MACs), base ec:3e:f7:5b:bb:40.
		 * The management MAC is base + 0x3f = ec:3e:f7:5b:bb:7f.
		 */
	};

	/* syspld@?? - CPLD: resets, LEDs, SFP LOS. Address not yet confirmed. */
};

/* Management port: the SoC's own GbE MAC, wired to the ASIC's CPU port. */
&mdio {
	status = "okay";

	/* Marvell 88E1118 at MDIO address 1. Found by letting the kernel
	 * scan: address 0 (the obvious guess, and what the first attempt
	 * used) is empty, which left mv643xx_eth at -EPROBE_DEFER forever.
	 * See findings/48. Confirmed on hardware -- eth0 links at
	 * 100 Mb/s full duplex and answers ping.
	 */
	ethphy0: ethernet-phy@1 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <1>;
	};
};

&eth0 {
	status = "okay";
	ethernet0-port@0 {
		phy-handle = <&ethphy0>;
		/* MAC comes from the IDPROM; U-Boot also sets ethaddr. */
	};
};

/* Root filesystem device is USB mass storage (Junos da0). */
&usb0 {
	status = "okay";
};

/*
 * 8 MB SPI NOR, memory-mapped at 0xf8000000 (boot.flash.start/size).
 * Layout from the U-Boot environment; see findings/29 and findings/45.
 * Marked read-only by default - nothing in bring-up should write it.
 */
&spi0 {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <20000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "uboot-golden";
				reg = <0x000000 0x080000>;
				read-only;
			};
			partition@80000 {
				label = "loader-golden";
				reg = <0x080000 0x080000>;
				read-only;
			};
			partition@100000 {
				label = "uboot-upgrade";
				reg = <0x100000 0x080000>;
			};
			partition@180000 {
				label = "loader-upgrade";
				reg = <0x180000 0x080000>;
			};
			/* 0x200000-0x6fffff is erased and unused: 5 MB free. */
			partition@200000 {
				label = "spare";
				reg = <0x200000 0x500000>;
			};
			partition@700000 {
				label = "upgrade-state";
				reg = <0x700000 0x0e0000>;
			};
			partition@7e0000 {
				label = "opqenv";
				reg = <0x7e0000 0x010000>;
			};
			partition@7f0000 {
				label = "u-boot-env";
				reg = <0x7f0000 0x002000>;
			};
		};
	};
};

/*
 * No SATA on this board. kirkwood.dtsi leaves sata_phy0/1 status="okay",
 * so phy_mvebu_sata probes them at internal-regs +0x82000/+0x84000 with
 * gate_clk 14 - and HANGS. Touching a Marvell peripheral whose clock gate
 * is off wedges the bus, which is exactly what happened: the boot stopped
 * dead at
 *
 *   calling  phy_mvebu_sata_driver_init+0x0/0x10 @ 1
 *
 * and never returned. Found with + ignore_loglevel.
 *
 * PHY_MVEBU_SATA is def_bool y and depends on MACH_KIRKWOOD, so it cannot
 * be turned off in the config while Kirkwood support is on - the node has
 * to be disabled here instead.
 */
&sata_phy0 {
	status = "disabled";
};

&sata_phy1 {
	status = "disabled";
};

/*
 * There is no PCIe on this board - 'pcieprobe' at the U-Boot prompt returns
 * "No PCIE supported" (findings/44). The Prestera is on the internal bus.
 */
&pciec {
	status = "disabled";
};

/*
 * Marvell Prestera DX (Cheetah-3) switch ASIC.
 *
 * Junos reports it as:
 *   mpfe0: <Juniper EX-series Packet Forwarding Engine>
 *          at mem 0xf4000000-0xf7ffffff irq 113 on mbus0
 *
 * The mbus target/attribute pair was read from the live CPU address-decode
 * windows at internal-regs +0x20000 (U-Boot: "md 0xf1020000 20"). Window 6:
 *
 *   ctrl 0x03ff00c1  base 0xf4000000
 *     bit0    = 1        enabled
 *     [7:4]   = 0x0c     target
 *     [15:8]  = 0x00     attribute
 *     [31:16] = 0x03ff   size = (0x3ff+1) << 16 = 64 MB
 *
 * The same decode reproduces two windows mainline already names -
 * MBUS_ID(0x01,0x2f) nand flash and MBUS_ID(0x03,0x01) crypto sram - which is
 * what confirms the bit layout.
 *
 * kirkwood.dtsi says a board changing 'ranges' must replace it completely, so
 * the whole property is restated here rather than appended to.
 */
&{/mbus@f1000000} {
	ranges = <MBUS_ID(0xf0, 0x01) 0 0xf1000000 0x0100000	/* internal-regs */
		  MBUS_ID(0x01, 0x2f) 0 0xf9000000 0x0800000	/* nand flash    */
		  MBUS_ID(0x03, 0x01) 0 0xfb000000 0x0010000	/* crypto sram   */
		  MBUS_ID(0x0c, 0x00) 0 0xf4000000 0x4000000>;	/* Prestera      */

	pp0: packet-processor@c00 {
		compatible = "juniper,ex2200-prestera", "marvell,prestera-dxch3";
		reg = <MBUS_ID(0x0c, 0x00) 0 0x4000000>;	/* 4 x 16 MB windows */
		interrupt-parent = <&intc>;
		interrupts = <113>;
		memory-region = <&pfe_dma>;
		/*
		 * No driver exists yet. Port map for whoever writes one --
		 * READ FROM THE LIVE ASIC, and NOT the identity map that
		 * static analysis first suggested (findings/49 corrects
		 * findings/38):
		 *
		 *   front-panel ge-0/0/N -> ASIC port (N XOR 1)   N = 0..11
		 *   uplink      ge-0/1/0 -> ASIC port 26
		 *   uplink      ge-0/1/1 -> ASIC port 27
		 *   ports 12, 13, 24, 25 -> internal
		 *
		 * Every copper pair is swapped. A driver built on N -> N
		 * mis-targets every port on the box, and the symptom (traffic
		 * on the neighbouring port) reads as a cabling fault.
		 *
		 * Confirmed three ways: phypeek, show phy, and the hardware
		 * VLAN member bitmap 0x0C000FF4 (bits 26/27 set, 12/13 clear).
		 * Quad PHY is an 88E1540, driven by mainline marvell.c.
		 */
		status = "disabled";
	};
};
