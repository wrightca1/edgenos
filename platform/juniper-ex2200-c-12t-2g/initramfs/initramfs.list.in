dir  /dev            0755 0 0
nod  /dev/console    0600 0 0 c 5 1
nod  /dev/null       0666 0 0 c 1 3
nod  /dev/tty        0666 0 0 c 5 0
nod  /dev/ttyS0      0600 0 0 c 4 64
dir  /proc           0755 0 0
dir  /sys            0755 0 0
dir  /tmp            1777 0 0
dir  /root           0700 0 0
dir  /etc            0755 0 0
dir  /bin            0755 0 0
dir  /sbin           0755 0 0
dir  /usr            0755 0 0
dir  /usr/bin        0755 0 0
dir  /usr/sbin       0755 0 0
file /bin/busybox    $(BUILD)/busybox-1.36.1/busybox 0755 0 0
slink /bin/sh        busybox 0777 0 0
file /init           $(BUILD)/initramfs2/init.sh 0755 0 0
file /etc/passwd     $(BUILD)/initramfs2/passwd 0644 0 0
file /etc/group      $(BUILD)/initramfs2/group 0644 0 0
