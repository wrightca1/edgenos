[Unit]
Description=EdgeNOS edged - Switch Daemon (BCM56846 Trident+)
After=platform-init.service local-fs.target
Requires=platform-init.service
ConditionPathExists=/dev/linux-kernel-bde
# swp-l3 is PartOf us, which propagates stop/restart but NOT start -- so after a
# stop/start cycle (a package upgrade) the swp addresses would stay unset. Wants
# pulls it back in; its own After=edged.service keeps the ordering right.
Wants=swp-l3.service

[Service]
Type=simple
ExecStart=/usr/sbin/edged -f -c /etc/edged/config.bcm
Restart=on-failure
RestartSec=5
LimitCORE=infinity
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal

# edged needs raw memory access for ASIC registers
AmbientCapabilities=CAP_NET_ADMIN CAP_SYS_RAWIO

[Install]
WantedBy=multi-user.target
