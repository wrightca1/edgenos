[Unit]
Description=EdgeNOS swp L3 address config (Nexus uplinks)
# edged creates the swpN TUN interfaces; we must run after it so they exist.
After=edged.service
Wants=edged.service
# Bind our lifecycle to edged's. edged recreates the swpN TUN devices from
# scratch on every start, so they come back with no addresses and no MTU --
# and a Type=oneshot + RemainAfterExit unit stays "active" across that, so it
# would never re-apply them. Without PartOf, `systemctl restart edged` (which
# the edged package's postinst does on every live upgrade) silently drops the
# whole L3 control plane until the next reboot.
PartOf=edged.service
ConditionPathExists=/etc/edged/swp-addrs.conf

[Service]
Type=oneshot
ExecStart=/usr/sbin/swp-l3-config.sh
RemainAfterExit=yes
# The loader waits up to 120s for /run/edged.ready; give systemd headroom
# beyond its default 90s oneshot start timeout.
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
