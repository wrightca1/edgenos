#!/usr/bin/env python3
"""edgenos — on-box CLI for EdgeNOS switches.

The operator front-end installed on the switch (vs the full build-host CLI). Thin
dispatcher over the on-box modules under /usr/lib/edgenos.

  edgenos version                       show this image's build identity
  edgenos platform name|show|init|hal   resolve / bring up / query the board (sensors, SFPs)
  edgenos sfp [show] [<port>]           list installed optics by front-panel port (any switch)
  edgenos interface [<port>]            per-port: link, IPs, routes, optic + light levels, counters
  edgenos int|show interface [<port>]   (aliases)
  edgenos pkg list                      packages this image is composed of
  edgenos pkg info|verify <file.epk>    inspect a package
  edgenos pkg install <file.epk>        install/upgrade a component on the LIVE switch
  edgenos pkg remove|show <name>        manage installed packages
  edgenos l2 show                       show L2-switch groups (bridged port sets)
  edgenos l2 set <vid> <port>...        bridge ports into one L2 switch (live)
  edgenos l2 del <vid> | l2 clear       remove a group / all groups (back to L3, live)
  edgenos acl show                      show ACLs (Field Processor rules) and bindings
  edgenos acl set <name> <seq> permit|deny <proto> <src> <dst> [dport N] [sport N]
  edgenos acl apply <name> <port>...    bind an ACL to ingress ports (live)
  edgenos acl del <name> [<seq>] | acl unapply <name> | acl clear
"""
import os
import re
import sys
import json
import subprocess

LIB = os.environ.get("EDGENOS_LIB", "/usr/lib/edgenos")


def cmd_version():
    vj = "/etc/edgenos/version.json"
    if not os.path.exists(vj):
        print("EdgeNOS (version unknown — no /etc/edgenos/version.json)")
        return 1
    d = json.load(open(vj))
    print(d.get("version_string", d.get("name", "EdgeNOS")))
    print(f"  platform : {d.get('onie_platform')}")
    print(f"  arch/asic: {d.get('arch')} / {d.get('asic')}   kernel {d.get('kernel')}")
    print(f"  datapath : {d.get('datapath')}")
    return 0


def _datapath():
    """(daemon, l2-groups.conf path) for the running datapath, else (None, None)."""
    for name, conf in (("edged", "/etc/edged/l2-groups.conf"),
                       ("bcmd", "/etc/bcmd/l2-groups.conf")):
        if subprocess.call(["pgrep", "-x", name], stdout=subprocess.DEVNULL) == 0:
            return name, conf
    return None, None


def _l2_read(conf):
    groups = {}
    try:
        for line in open(conf):
            line = line.split("#")[0].strip()
            t = line.split()
            if len(t) >= 2:
                groups[t[0]] = t[1:]
    except OSError:
        pass
    return groups


def _l2_write(conf, groups):
    os.makedirs(os.path.dirname(conf), exist_ok=True)
    with open(conf, "w") as f:
        f.write("# EdgeNOS L2-switch groups — bridge a set of ports into one VLAN.\n")
        f.write("# <vid> <port> <port> ...   (ports: swpN on 5610, geN/xeN on 4610)\n")
        for vid in sorted(groups, key=int):
            f.write("%s %s\n" % (vid, " ".join(groups[vid])))


def cmd_l2(rest):
    daemon, conf = _datapath()
    if not daemon:
        print("no datapath daemon (edged/bcmd) running — cannot manage L2 groups")
        return 1
    sub = rest[0] if rest else "show"
    groups = _l2_read(conf)

    if sub == "show":
        if not groups:
            print("no L2-switch groups (every port is its own L3 interface)")
            return 0
        print("L2-switch groups [%s %s]:" % (daemon, conf))
        for vid in sorted(groups, key=int):
            print("  VLAN %s  ⇄  %s" % (vid, " ".join(groups[vid])))
        return 0
    if sub == "set" and len(rest) >= 3:
        vid, ports = rest[1], rest[2:]
        groups[vid] = ports
    elif sub == "del" and len(rest) >= 2:
        groups.pop(rest[1], None)
    elif sub == "clear":
        groups = {}
    else:
        print("usage: edgenos l2 [show | set <vid> <port>... | del <vid> | clear]")
        return 1

    _l2_write(conf, groups)
    subprocess.call(["pkill", "-HUP", "-x", daemon])      # live re-sync
    print("applied — %s re-synced L2 groups from %s" % (daemon, conf))
    return 0


def _acl_read(conf):
    rules, binds = {}, {}
    try:
        for line in open(conf):
            line = line.split("#")[0].strip()
            t = line.split()
            if len(t) < 2:
                continue
            if t[1] == "apply":
                binds[t[0]] = t[2:]
            else:
                try:
                    rules[(t[0], int(t[1]))] = t[2:]
                except ValueError:
                    pass
    except OSError:
        pass
    return rules, binds


def _acl_write(conf, rules, binds):
    os.makedirs(os.path.dirname(conf), exist_ok=True)
    with open(conf, "w") as f:
        f.write("# EdgeNOS ACLs — ingress Field Processor rules (see docs/acl-design.md).\n")
        f.write("# rule:  <name> <seq> permit|deny <proto> <src-cidr> <dst-cidr> [dport N] [sport N]\n")
        f.write("# bind:  <name> apply <port>...   (ports: swpN on 5610, geN/xeN on 4610)\n")
        for name, seq in sorted(rules, key=lambda k: (k[0], k[1])):
            f.write("%s %d %s\n" % (name, seq, " ".join(rules[(name, seq)])))
        for name in sorted(binds):
            f.write("%s apply %s\n" % (name, " ".join(binds[name])))


def cmd_acl(rest):
    daemon, l2conf = _datapath()
    if not daemon:
        print("no datapath daemon (edged/bcmd) running — cannot manage ACLs")
        return 1
    conf = os.path.join(os.path.dirname(l2conf), "acls.conf")
    sub = rest[0] if rest else "show"
    rules, binds = _acl_read(conf)

    if sub == "show":
        if not rules and not binds:
            print("no ACLs configured")
            return 0
        print("ACLs [%s %s]:" % (daemon, conf))
        for name in sorted(set([n for n, _ in rules] + list(binds))):
            applied = " ".join(binds.get(name, [])) or "(not applied — inert)"
            print("  %s   apply: %s" % (name, applied))
            for n, seq in sorted([k for k in rules if k[0] == name], key=lambda k: k[1]):
                print("    %4d  %s" % (seq, " ".join(rules[(n, seq)])))
        return 0
    if sub == "set" and len(rest) >= 7 and rest[3] in ("permit", "deny"):
        try:
            rules[(rest[1], int(rest[2]))] = rest[3:]      # action proto src dst [dport N]...
        except ValueError:
            print("seq must be a number")
            return 1
    elif sub == "del" and len(rest) >= 2:
        if len(rest) >= 3:
            try:
                rules.pop((rest[1], int(rest[2])), None)
            except ValueError:
                print("seq must be a number")
                return 1
        else:
            rules = {k: v for k, v in rules.items() if k[0] != rest[1]}
            binds.pop(rest[1], None)
    elif sub == "apply" and len(rest) >= 3:
        binds[rest[1]] = rest[2:]
    elif sub == "unapply" and len(rest) >= 2:
        binds.pop(rest[1], None)
    elif sub == "clear":
        rules, binds = {}, {}
    else:
        print("usage: edgenos acl [show |")
        print("   set <name> <seq> permit|deny <proto> <src-cidr> <dst-cidr> [dport N] [sport N] |")
        print("   del <name> [<seq>] | apply <name> <port>... | unapply <name> | clear]")
        return 1

    _acl_write(conf, rules, binds)
    subprocess.call(["pkill", "-HUP", "-x", daemon])          # live re-program
    print("applied — %s re-synced ACLs from %s" % (daemon, conf))
    return 0


def cmd_sfp(rest):
    """List installed optics by front-panel port — identical on every switch.
    Translates to the platform HAL (sfps()); the board maps i2c bus -> swpN."""
    sys.path.insert(0, os.path.join(LIB, "platform"))
    try:
        from current import load_platform
        optics = load_platform().sfps()
    except Exception as e:                       # HALUnsupported / no board / no glob
        print("sfp: hardware inventory unavailable (%s)" % e)
        return 1
    args = [a for a in rest if a not in ("show",)]
    as_json = "--json" in args
    args = [a for a in args if a != "--json"]
    want = None
    if args:                                     # optional single-port filter: swp6 or 6
        want = args[0] if args[0].startswith(("swp", "ge", "xe")) else "swp" + args[0]
        optics = [o for o in optics if o.get("name") == want]
    if as_json:
        print(json.dumps(optics, indent=1))
        return 0
    if not optics:
        print("no optic present%s" % (" in %s" % want if want else ""))
        return 0
    print("%-7s %-4s %-7s %-15s %-18s %s" % ("PORT", "BUS", "TYPE", "VENDOR", "PART", "SERIAL"))
    for o in optics:
        print("%-7s %-4s %-7s %-15s %-18s %s" % (
            o.get("name") or ("bus%s" % o.get("bus")), o.get("bus", "?"), o.get("type", "?"),
            (o.get("vendor") or "-")[:15], (o.get("part") or "-")[:18], o.get("serial") or "-"))
    return 0


def _sysnet(iface, leaf):
    try:
        with open("/sys/class/net/%s/%s" % (iface, leaf)) as f:
            return f.read().strip()
    except OSError:
        return None


def _run(*args):
    return subprocess.run(args, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL).stdout.decode()


def _ifaddrs(iface):
    v4, v6 = [], []
    for line in _run("ip", "-o", "addr", "show", "dev", iface).splitlines():
        t = line.split()
        if "inet" in t:
            v4.append(t[t.index("inet") + 1])
        if "inet6" in t:
            v6.append(t[t.index("inet6") + 1])
    return v4, v6


def _ifroutes(iface):
    out = []
    for fam in ([], ["-6"]):
        out += [l.strip() for l in _run("ip", *fam, "route", "show", "dev", iface).splitlines() if l.strip()]
    return out


def _natkey(n):
    m = re.search(r"(\d+)", n)
    return (re.sub(r"\d+", "", n), int(m.group(1)) if m else 0)


def _linkstate(p):
    oper, carrier = _sysnet(p, "operstate") or "?", _sysnet(p, "carrier")
    if oper == "up":
        return "up"
    return "no-carrier" if carrier == "0" else oper


def _iface_detail(p, opt, plat):
    speed = _sysnet(p, "speed")
    spd = "  %sG" % (int(speed) // 1000) if speed and speed.lstrip("-").isdigit() and int(speed) > 0 else ""
    print("%s: %s%s  mtu %s  mac %s" % (p, _linkstate(p).upper(), spd,
                                        _sysnet(p, "mtu") or "?", _sysnet(p, "address") or "?"))
    v4, v6 = _ifaddrs(p)
    if v4:
        print("  ipv4  : " + ", ".join(v4))
    if v6:
        print("  ipv6  : " + ", ".join(v6))
    if opt:
        print("  optic : %s %s %s (SN %s, bus %s)" % (opt.get("type"), opt.get("vendor"),
                                                      opt.get("part"), opt.get("serial"), opt.get("bus")))
        ddm = None
        try:
            ddm = plat.sfp_diagnostics(int(opt["bus"]), opt.get("type", "SFP")) if plat else None
        except Exception:
            ddm = None
        if ddm and "lanes" in ddm:
            print("  light : temp %s°C  vcc %sV" % (ddm.get("temp_c"), ddm.get("vcc_v")))
            for i, ln in enumerate(ddm["lanes"], 1):
                print("    lane%d: tx %s dBm  rx %s dBm  bias %s mA"
                      % (i, ln["tx_power_dbm"], ln["rx_power_dbm"], ln["tx_bias_ma"]))
        elif ddm:
            print("  light : temp %s°C  vcc %sV  tx %s dBm  rx %s dBm  bias %s mA"
                  % (ddm["temp_c"], ddm["vcc_v"], ddm["tx_power_dbm"], ddm["rx_power_dbm"], ddm["tx_bias_ma"]))
    routes = _ifroutes(p)
    if routes:
        print("  routes: " + ("\n          ".join(routes[:8])))
    g = lambda k: _sysnet(p, "statistics/" + k) or "0"
    print("  stats : rx %s pkt / %s err    tx %s pkt / %s err" % (g("rx_packets"), g("rx_errors"),
                                                                  g("tx_packets"), g("tx_errors")))


def cmd_interface(rest):
    """Consolidated per-port view — link, IPs, routes, optic + light levels, counters.
    Board-agnostic: OS for link/addr/route/counters, the HAL for optic + DDM."""
    sys.path.insert(0, os.path.join(LIB, "platform"))
    plat = None
    try:
        from current import load_platform
        plat = load_platform()
    except Exception:
        pass
    args = [a for a in rest if a not in ("show", "interface")]
    if args:                                                  # detail: lazy — one optic/port
        for a in args:
            p = a if a.startswith(("swp", "ge", "xe")) else "swp" + a
            if not os.path.exists("/sys/class/net/" + p):
                print("%s: no such interface" % p)
                continue
            try:
                opt = plat.optic_for_port(p) if plat else None
            except Exception:
                opt = None
            _iface_detail(p, opt, plat)
            print()
        return 0
    # summary: one full optic inventory sweep (fast on sysfs boards; slower on raw-i2c)
    optics = {}
    try:
        optics = {o["name"]: o for o in (plat.sfps() if plat else []) if o.get("name")}
    except Exception:
        pass
    ports = sorted([n for n in os.listdir("/sys/class/net") if n.startswith(("swp", "ge", "xe"))],
                   key=_natkey)
    print("%-7s %-11s %-5s %-20s %s" % ("PORT", "STATE", "MTU", "IPV4", "OPTIC"))
    shown = 0
    for p in ports:
        v4, _ = _ifaddrs(p)
        opt = optics.get(p)
        if _linkstate(p) != "up" and not v4 and not opt:
            continue
        optd = "%s %s" % (opt.get("type"), opt.get("part")) if opt else "-"
        print("%-7s %-11s %-5s %-20s %s" % (p, _linkstate(p), _sysnet(p, "mtu") or "?",
                                            v4[0] if v4 else "-", optd))
        shown += 1
    if not shown:
        print("(no up/addressed/optic ports)")
    return 0


def main(argv):
    if len(argv) < 2:
        print(__doc__.strip())
        return 1
    cmd, rest = argv[1], argv[2:]
    if cmd in ("version", "--version", "-v"):
        return cmd_version()
    if cmd == "platform":
        sys.path.insert(0, os.path.join(LIB, "platform"))
        import current
        return current.main(["platform"] + rest)
    if cmd == "pkg":
        sys.path.insert(0, LIB)                  # epkg.py + epk.py live here on-box
        import epkg
        return epkg.main(["epkg"] + rest)
    if cmd == "sfp":
        return cmd_sfp(rest)
    if cmd in ("interface", "int", "intf"):
        return cmd_interface(rest)
    if cmd == "show" and rest and rest[0] == "interface":
        return cmd_interface(rest[1:])
    if cmd == "l2":
        return cmd_l2(rest)
    if cmd == "acl":
        return cmd_acl(rest)
    print(__doc__.strip())
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
