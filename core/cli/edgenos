#!/usr/bin/env python3
"""edgenos — on-box CLI for EdgeNOS switches.

The operator front-end installed on the switch (vs the full build-host CLI). Thin
dispatcher over the on-box modules under /usr/lib/edgenos.

  edgenos version                       show this image's build identity
  edgenos platform name|show|init|hal   resolve / bring up / query the board (sensors, SFPs)
  edgenos pkg list                      packages this image is composed of
  edgenos pkg info|verify <file.epk>    inspect a package
  edgenos pkg install <file.epk>        install/upgrade a component on the LIVE switch
  edgenos pkg remove|show <name>        manage installed packages
  edgenos l2 show                       show L2-switch groups (bridged port sets)
  edgenos l2 set <vid> <port>...        bridge ports into one L2 switch (live)
  edgenos l2 del <vid> | l2 clear       remove a group / all groups (back to L3, live)
  edgenos acl show                      show ACLs (Field Processor rules) and bindings
  edgenos acl set <name> <seq> permit|deny <proto> <src> <dst> [dport N] [sport N]
  edgenos acl apply <name> <port>...    bind an ACL to ingress ports (live)
  edgenos acl del <name> [<seq>] | acl unapply <name> | acl clear
"""
import os
import sys
import json
import subprocess

LIB = os.environ.get("EDGENOS_LIB", "/usr/lib/edgenos")


def cmd_version():
    vj = "/etc/edgenos/version.json"
    if not os.path.exists(vj):
        print("EdgeNOS (version unknown — no /etc/edgenos/version.json)")
        return 1
    d = json.load(open(vj))
    print(d.get("version_string", d.get("name", "EdgeNOS")))
    print(f"  platform : {d.get('onie_platform')}")
    print(f"  arch/asic: {d.get('arch')} / {d.get('asic')}   kernel {d.get('kernel')}")
    print(f"  datapath : {d.get('datapath')}")
    return 0


def _proc_alive(name):
    """pgrep that works with both procps (comm match) and busybox (argv[0] match)."""
    if subprocess.call(["pgrep", "-x", name], stdout=subprocess.DEVNULL) == 0:
        return True
    return subprocess.call(["pgrep", name], stdout=subprocess.DEVNULL) == 0


def _hup(name):
    if subprocess.call(["pkill", "-HUP", "-x", name], stdout=subprocess.DEVNULL) != 0:
        subprocess.call(["pkill", "-HUP", name], stdout=subprocess.DEVNULL)


def _datapath():
    """(daemon, l2-groups.conf path) for the running datapath, else (None, None)."""
    for name, conf in (("edged-vswitch", "/etc/edged/l2-groups.conf"),
                       ("edged", "/etc/edged/l2-groups.conf"),
                       ("bcmd", "/etc/bcmd/l2-groups.conf")):
        if _proc_alive(name):
            return name, conf
    return None, None


def _l2_read(conf):
    groups = {}
    try:
        for line in open(conf):
            line = line.split("#")[0].strip()
            t = line.split()
            if len(t) >= 2:
                groups[t[0]] = t[1:]
    except OSError:
        pass
    return groups


def _l2_write(conf, groups):
    os.makedirs(os.path.dirname(conf), exist_ok=True)
    with open(conf, "w") as f:
        f.write("# EdgeNOS L2-switch groups — bridge a set of ports into one VLAN.\n")
        f.write("# <vid> <port> <port> ...   (ports: swpN on 5610, geN/xeN on 4610, pgeN on the virtual vswitch)\n")
        for vid in sorted(groups, key=int):
            f.write("%s %s\n" % (vid, " ".join(groups[vid])))


def cmd_l2(rest):
    daemon, conf = _datapath()
    if not daemon:
        print("no datapath daemon (edged/bcmd) running — cannot manage L2 groups")
        return 1
    sub = rest[0] if rest else "show"
    groups = _l2_read(conf)

    if sub == "show":
        if not groups:
            print("no L2-switch groups (every port is its own L3 interface)")
            return 0
        print("L2-switch groups [%s %s]:" % (daemon, conf))
        for vid in sorted(groups, key=int):
            print("  VLAN %s  ⇄  %s" % (vid, " ".join(groups[vid])))
        return 0
    if sub == "set" and len(rest) >= 3:
        vid, ports = rest[1], rest[2:]
        groups[vid] = ports
    elif sub == "del" and len(rest) >= 2:
        groups.pop(rest[1], None)
    elif sub == "clear":
        groups = {}
    else:
        print("usage: edgenos l2 [show | set <vid> <port>... | del <vid> | clear]")
        return 1

    _l2_write(conf, groups)
    _hup(daemon)                                          # live re-sync
    print("applied — %s re-synced L2 groups from %s" % (daemon, conf))
    return 0


def _acl_read(conf):
    rules, binds = {}, {}
    try:
        for line in open(conf):
            line = line.split("#")[0].strip()
            t = line.split()
            if len(t) < 2:
                continue
            if t[1] == "apply":
                binds[t[0]] = t[2:]
            else:
                try:
                    rules[(t[0], int(t[1]))] = t[2:]
                except ValueError:
                    pass
    except OSError:
        pass
    return rules, binds


def _acl_write(conf, rules, binds):
    os.makedirs(os.path.dirname(conf), exist_ok=True)
    with open(conf, "w") as f:
        f.write("# EdgeNOS ACLs — ingress Field Processor rules (see docs/acl-design.md).\n")
        f.write("# rule:  <name> <seq> permit|deny <proto> <src-cidr> <dst-cidr> [dport N] [sport N]\n")
        f.write("# bind:  <name> apply <port>...   (ports: swpN on 5610, geN/xeN on 4610, pgeN on the virtual vswitch)\n")
        for name, seq in sorted(rules, key=lambda k: (k[0], k[1])):
            f.write("%s %d %s\n" % (name, seq, " ".join(rules[(name, seq)])))
        for name in sorted(binds):
            f.write("%s apply %s\n" % (name, " ".join(binds[name])))


def cmd_acl(rest):
    daemon, l2conf = _datapath()
    if not daemon:
        print("no datapath daemon (edged/bcmd) running — cannot manage ACLs")
        return 1
    conf = os.path.join(os.path.dirname(l2conf), "acls.conf")
    sub = rest[0] if rest else "show"
    rules, binds = _acl_read(conf)

    if sub == "show":
        if not rules and not binds:
            print("no ACLs configured")
            return 0
        print("ACLs [%s %s]:" % (daemon, conf))
        for name in sorted(set([n for n, _ in rules] + list(binds))):
            applied = " ".join(binds.get(name, [])) or "(not applied — inert)"
            print("  %s   apply: %s" % (name, applied))
            for n, seq in sorted([k for k in rules if k[0] == name], key=lambda k: k[1]):
                print("    %4d  %s" % (seq, " ".join(rules[(n, seq)])))
        return 0
    if sub == "set" and len(rest) >= 7 and rest[3] in ("permit", "deny"):
        try:
            rules[(rest[1], int(rest[2]))] = rest[3:]      # action proto src dst [dport N]...
        except ValueError:
            print("seq must be a number")
            return 1
    elif sub == "del" and len(rest) >= 2:
        if len(rest) >= 3:
            try:
                rules.pop((rest[1], int(rest[2])), None)
            except ValueError:
                print("seq must be a number")
                return 1
        else:
            rules = {k: v for k, v in rules.items() if k[0] != rest[1]}
            binds.pop(rest[1], None)
    elif sub == "apply" and len(rest) >= 3:
        binds[rest[1]] = rest[2:]
    elif sub == "unapply" and len(rest) >= 2:
        binds.pop(rest[1], None)
    elif sub == "clear":
        rules, binds = {}, {}
    else:
        print("usage: edgenos acl [show |")
        print("   set <name> <seq> permit|deny <proto> <src-cidr> <dst-cidr> [dport N] [sport N] |")
        print("   del <name> [<seq>] | apply <name> <port>... | unapply <name> | clear]")
        return 1

    _acl_write(conf, rules, binds)
    _hup(daemon)                                              # live re-program
    print("applied — %s re-synced ACLs from %s" % (daemon, conf))
    return 0


def main(argv):
    if len(argv) < 2:
        print(__doc__.strip())
        return 1
    cmd, rest = argv[1], argv[2:]
    if cmd in ("version", "--version", "-v"):
        return cmd_version()
    if cmd == "platform":
        sys.path.insert(0, os.path.join(LIB, "platform"))
        import current
        return current.main(["platform"] + rest)
    if cmd == "pkg":
        sys.path.insert(0, LIB)                  # epkg.py + epk.py live here on-box
        import epkg
        return epkg.main(["epkg"] + rest)
    if cmd == "l2":
        return cmd_l2(rest)
    if cmd == "acl":
        return cmd_acl(rest)
    print(__doc__.strip())
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
