#!/usr/bin/env python3
"""
edgenos — top-level CLI for the unified EdgeNOS build/version/package system.

Subcommands (Phase 1):
  db list                       list known platforms
  db validate                   schema + referential-integrity check of the switch DB
  db show <onie_platform>       resolved platform+arch+asic view
  version <onie_platform>       compute the build identity for a platform
  version <onie_platform> --json <p> --os-release <p>   write stamps

  pkg build <spec.yml> --source-root <dir> --platform <p>   build an .epk package
  pkg base --from <rootfs.sqsh> --platform <p>              capture a base-system .epk
  pkg info|verify <file.epk>                                inspect a package
  pkg install <file.epk> [--root /] [--force]               install (on-box)
  pkg list|remove|show [--root /]                            manage installed pkgs

  build <onie_platform> --source-root <dir>                 build the ONIE installer
  catalog [--json]                                          list downloadable switches
  platform name|show|init [--root /]                        resolve/bring up the board (ONL-style)
"""
import os, sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(ROOT, "tools"))
sys.path.insert(0, os.path.join(ROOT, "packaging"))
sys.path.insert(0, os.path.join(ROOT, "packaging", "version"))
sys.path.insert(0, os.path.join(ROOT, "packaging", "pkgtool"))


def main(argv):
    if len(argv) < 2:
        print(__doc__.strip())
        return 1
    cmd, rest = argv[1], argv[2:]
    if cmd == "db":
        import switchdb
        switchdb.main(["switchdb"] + rest)
    elif cmd == "version":
        import version
        version.main(["version"] + rest)
    elif cmd == "pkg":
        # `pkg build` -> host builder; `pkg base` -> base capture; else -> on-box epkg
        if rest and rest[0] == "build":
            import pkgbuild
            return pkgbuild.main(["pkgbuild"] + rest[1:])
        if rest and rest[0] == "base":
            import pkgbase
            return pkgbase.main(["pkgbase"] + rest[1:])
        import epkg
        return epkg.main(["epkg"] + rest)
    elif cmd == "build":
        import imgbuild
        return imgbuild.main(["imgbuild"] + rest)
    elif cmd == "catalog":
        import catalog
        return catalog.main(["catalog"] + rest)
    elif cmd == "platform":
        sys.path.insert(0, os.path.join(ROOT, "core", "platform"))
        import current
        return current.main(["platform"] + rest)
    else:
        print(__doc__.strip())
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
