+     * it keeps ING_PHYS_TO_LOGIC_MAPm / EGR_LOGIC_TO_PHYS_MAPr / the VLAN/L2
+     * port bitmaps / and cumulus_replicate.c all in one logical numbering.
+     */
+    if (inverse) {
+        /* logical -> physical */
