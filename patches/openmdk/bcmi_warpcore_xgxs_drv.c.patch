+            uint32_t ctrl;
+            cdk_xgs_miim_read(unit_id, phy_addr, 0x1d, &ctrl);
+            ctrl |= 0x400f;
+            ctrl &= ~0x8000;
+            cdk_xgs_miim_write(unit_id, phy_addr, 0x1d, ctrl);
+        }
+
+        /* Step 2: Stop PLL sequencer */
+        {
+            uint32_t xgxs;
+            cdk_xgs_miim_read(unit_id, phy_addr,
+                (1 << 16) | 0x8000, &xgxs);
+            xgxs &= ~0x2000;
+            cdk_xgs_miim_write(unit_id, phy_addr,
+                (1 << 16) | 0x8000, xgxs);
+        }
