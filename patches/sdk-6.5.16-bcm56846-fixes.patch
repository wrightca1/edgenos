diff --git a/sdk-6.5.16/src/soc/common/schan.c b/sdk-6.5.16/src/soc/common/schan.c
index 048f11175..38b7ef684 100644
--- a/sdk-6.5.16/src/soc/common/schan.c
+++ b/sdk-6.5.16/src/soc/common/schan.c
@@ -211,6 +211,18 @@ soc_schan_header_cmd_set(int unit, schan_header_t *header, int opcode,
         header->v3.dma = dma;
         header->v3.bank_ignore_mask = bank_ignore_mask;
     } else {
+        /* AS5610 BCM56846: this chip sets CDK_XGS_CHIP_FLAG_SCHAN_SB0 in edged's CDK, which forces
+         * the S-Channel command's SOURCE block to 0 (not the CMIC block 5). The reply is routed
+         * back over SBUS to src_blk; with src_blk=5 the engine sends the READ_REG_ACK to block 5
+         * instead of the CMIC, so the reply never lands in the CMIC message buffer (op completes
+         * with DONE but no ACK). Match edged: force src_blk=0 for this device. */
+        {
+            uint16 _dsb; uint8 _rsb;
+            soc_cm_get_id(unit, &_dsb, &_rsb);
+            if (_dsb == BCM56846_DEVICE_ID) {
+                src_blk = 0;
+            }
+        }
         header->v2.opcode = opcode;
         header->v2.dst_blk = dst_blk;
         header->v2.src_blk = src_blk;
@@ -963,9 +975,16 @@ int soc_schan_init(int unit)
 #endif
 
 #if defined(BCM_CMICM_SUPPORT)
-    if (soc_feature(unit, soc_feature_cmicm)) {
-        rv = soc_cmicm_schan_init(unit, &_soc_schan_drv[unit]);
-        return rv;
+    {
+        /* AS5610 (EdgeNOS): the BCM56846 is a CMICe chip (SCHAN engine at CMIC_SCHAN_CTRL=0x50,
+         * message buffer at BAR0 0x00). This was PROVEN by edged's working OpenMDK driver, whose
+         * cdk_xgs_schan_op targets exactly 0x50 / offset-0 and completes on real hardware. An
+         * earlier hack forced the CMICm SCHAN (0x31000) here — that engine does NOT respond on this
+         * chip, so every op timed out. Do NOT force cmicm for 0xb846; fall through to cmice below. */
+        if (soc_feature(unit, soc_feature_cmicm)) {
+            rv = soc_cmicm_schan_init(unit, &_soc_schan_drv[unit]);
+            return rv;
+        }
     }
 #endif
 
